# Neon Postgres connection string (server-side only)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Random 32+ char string used to sign the public order form token
SESSION_SECRET=change-me-to-a-long-random-string

# Owner account created by `npm run db:seed` (change password after first login)
OWNER_USERNAME=owner
OWNER_NAME=Owner
OWNER_PASSWORD=choose-a-strong-password

# Telegram family group alerts (server-side only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# set to "false" to only alert on NEW orders (not taken/delivered)
TELEGRAM_NOTIFY_STATUS=true

# Web push (generate with `npm run vapid`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Timezone used for the "today" / "this week" payout summaries
STORE_TZ=America/New_York

# Optional: address suggestions while typing (Google Places API (New)). Server-side only.
GOOGLE_MAPS_API_KEY=
